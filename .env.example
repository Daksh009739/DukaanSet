# Local development database. Never commit the .data directory.
DATABASE_PATH=.data/dukaanset.sqlite
# Public canonical URL: set to the real domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trusted origin for emailed links. Use your HTTPS origin in production.
AUTH_BASE_URL=http://127.0.0.1:3000
# Development only: file delivers one-use links to a PRIVATE local outbox.
# Production: resend requires a verified sending domain and the following credentials.
AUTH_EMAIL_MODE=file
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# Optional private outbox directory. Never point this inside public/.
AUTH_MAIL_DIRECTORY=
# Optional read-only AI. No requests are made unless provider, key and model are configured.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional vision-capable model for reviewed photo-to-stock / photo-to-bill.
# Uses OPENAI_MODEL when blank. Requires AI_PROVIDER=openai and OPENAI_API_KEY.
# Configure only on the durable server; never use a NEXT_PUBLIC credential.
DOCUMENT_VISION_MODEL=
# Optional VoiceOS audio, configured only on the durable backend (not the Vercel gateway).
# See docs/VOICEOS-3.md. Empty providers use device recognition/voices or typing.
VOICE_STT_PROVIDER=
VOICE_STT_MODEL=gpt-transcribe
VOICE_TTS_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional My Voice AI; server-only. See docs/MY-VOICE-AI.md for ownership verification.
# All five values are required; blank values keep enrollment unavailable.
MY_VOICE_PROVIDER=
RESEMBLE_API_KEY=
MY_VOICE_ENCRYPTION_KEY=
MY_VOICE_VERIFICATION_URL=
MY_VOICE_VERIFICATION_KEY=
# Optional shop-owned Smart UPI. Requires an approved Razorpay Technology Partner application.
# Use the official OAuth callback; keep these server-only. Blank fields leave tracking unavailable.
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=
RAZORPAY_MODE=test
UPI_TOKEN_ENCRYPTION_KEY=
RAZORPAY_WEBHOOK_SECRET=
# Keep the previous webhook secret only during a controlled key-rotation retry window.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Optional provider-enabled dynamic QR requires read_write authorisation and confirmed entitlement.
RAZORPAY_DYNAMIC_QR=0
# Background polling runs only with valid provider configuration and shop authorisation.
DUKAANSET_UPI_WORKER=1
# Actual contracted rates, optional; leave empty to show cost as unavailable.
VOICE_STT_USD_PER_MINUTE=
VOICE_TTS_USD_PER_MILLION_CHARACTERS=
# Global rolling 24-hour request ceiling; defaults to 10000, range 1..100000.
VOICE_AUDIO_DAILY_MAX_REQUESTS=10000
# Client endpoint pause, 900..4000 ms; rebuild frontend after changing it.
# Default 1800 ms. Longer values tolerate longer pauses before automatic stop.
NEXT_PUBLIC_VOICE_END_SILENCE_MS=1800
# Optional official WhatsApp delivery; configure only on the durable backend.
# Maps business UUIDs to sender IDs, a verified Graph version, template mappings
# and uppercase secret environment-variable references. See docs/WHATSAPP-DELIVERY.md.
WHATSAPP_CONNECTIONS_JSON=
# Add the referenced SHOP_WA_TOKEN / SHOP_WA_APP_SECRET / SHOP_WA_VERIFY_TOKEN
# in the deployment secret manager. Never paste credentials into this repository.
# Future managed database adapter; currently unused.
DATABASE_URL=
# Optional weather on the durable backend. Uses the shop's saved city/location;
# no device location or invented weather. No requests without this server key.
OPENWEATHER_API_KEY=

# Local by default. Hosted backends use staging or production.
DUKAANSET_ENV=local
DUKAANSET_PUBLIC_ORIGIN=
DUKAANSET_DATA_ROOT=
DUKAANSET_DEPLOYMENT_TOKEN=
# Vercel gateway only: isolated HTTPS backend, no database/email/AI keys here.
DUKAANSET_BACKEND_ORIGIN=
# Docker build arguments or provider Git metadata; not invented release values.
DUKAANSET_GIT_SHA=
DUKAANSET_GIT_BRANCH=
# Production secure cookies require HTTPS. NODE_ENV is managed by Next.js.
