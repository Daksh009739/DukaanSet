# Local development database. Never commit the .data directory.
DATABASE_PATH=.data/dukaanset.sqlite
# Public canonical URL: set to the real domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trusted origin for emailed links. Use your HTTPS origin in production.
AUTH_BASE_URL=http://127.0.0.1:3000
# Development only: file delivers one-use links to a PRIVATE local outbox.
# Production: resend requires a verified sending domain and the following credentials.
AUTH_EMAIL_MODE=file
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# Optional private outbox directory. Never point this inside public/.
AUTH_MAIL_DIRECTORY=
# Optional read-only AI. No requests are made unless provider, key and model are configured.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
# Future managed database adapter; currently unused.
DATABASE_URL=
# Production secure cookies require HTTPS. NODE_ENV is managed by Next.js.
