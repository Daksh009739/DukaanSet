# Local development database. Never commit the .data directory.
DATABASE_PATH=.data/dukaanset.sqlite
# Public canonical URL: set to the real domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Unused future AI boundary. A key alone does not enable AI; the provider adapter still needs implementation and testing.
OPENAI_API_KEY=
# Future managed database adapter; currently unused.
DATABASE_URL=
# Production secure cookies require HTTPS. NODE_ENV is managed by Next.js.
